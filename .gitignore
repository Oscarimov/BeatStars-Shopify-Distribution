# Secrets / credentials — never commit real config
config.json
scripts/config.json
*.local.json

# Sessions & auth caches created at runtime
shopify_session.json
beatstars_session.json
.shopify_token_cache
scripts/shopify_session.json
scripts/beatstars_session.json
scripts/.shopify_token_cache

# Persistent real-Chrome profile (cookies, login state) - very sensitive
chrome_profile/
scripts/chrome_profile/

# Runtime data / logs generated by the tool
digital_downloads_mapping.json
digital_downloads_import.csv
scripts/digital_downloads_mapping.json
scripts/digital_downloads_import.csv
*.log
debug_dumps/

# Downloaded beats (personal media, can be large)
/Beats/
/beats/

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Build artifacts
dist/
build/
ms-playwright/
*.exe

# OS / editor
.DS_Store
Thumbs.db
.vscode/
